{
  "name": "bluekode-lms",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev -w packages/api & npm run dev -w packages/web",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
