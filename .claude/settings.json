{
  "project": {
    "name": "bluekode-lms",
    "type": "react-frontend",
    "language": "typescript",
    "frameworks": ["react", "tailwindcss", "shadcn-ui", "zustand", "axios", "zod"]
  },
  "context": {
    "projectAware": true,
    "includeFileTree": true,
    "includeImports": true,
    "includeTypes": true
  },
  "typescript": {
    "enabled": true,
    "strict": true,
    "noImplicitAny": true,
    "preferTypeGuardsOverAssertions": true,
    "suggestReturnTypes": true
  },
  "react": {
    "functionalComponentsOnly": true,
    "preferCustomHooks": true,
    "warnOnClassComponents": true,
    "suggestMemoization": true,
    "enforceKeyProps": true
  },
  "tailwind": {
    "enabled": true,
    "enforceUtilityFirst": true,
    "mobilFirst": true,
    "suggestResponsiveVariants": true
  },
  "shadcnUi": {
    "enabled": true,
    "preferPrimitivesAsBase": true
  },
  "editor": {
    "formatOnSave": true,
    "organizeImports": true,
    "removeUnusedImports": true,
    "sortImports": true
  },
  "codeGeneration": {
    "reusableComponents": true,
    "separateConcerns": true,
    "featureFirstOrganization": true,
    "smallFocusedFiles": true,
    "strictProps": true,
    "avoidInlineBusinessLogic": true,
    "avoidDeepPropDrilling": true,
    "preferCompositionOverInheritance": true
  },
  "refactoring": {
    "intelligentRefactoring": true,
    "extractRepeatedJSX": true,
    "extractCustomHooks": true,
    "requireConfirmationBeforeOverwrite": true
  },
  "search": {
    "codebaseSearch": true,
    "projectWideContext": true,
    "semanticSearch": true
  },
  "linting": {
    "lintFriendlyOutput": true,
    "eslintAware": true,
    "prettierAware": true
  },
  "safety": {
    "requireConfirmationBeforeFileDelete": true,
    "requireConfirmationBeforeOverwrite": true,
    "neverAutoInstallPackages": true,
    "neverAutoDeleteFiles": true,
    "neverRunDestructiveCommands": true,
    "safeFileCreation": true,
    "safeFileEditing": true
  },
  "permissions": {
    "allow": [
      "Read(**)",
      "Edit(**)",
      "Write(**)",
      "Glob(**)",
      "Grep(**)"
    ],
    "deny": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(del *)",
      "Bash(npm install *)",
      "Bash(yarn add *)",
      "Bash(pnpm add *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)"
    ]
  }
}
